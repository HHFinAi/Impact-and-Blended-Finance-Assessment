{
  "agent": "impact-blended-finance-agent",
  "version": "0.2.0",
  "operations": [
    {
      "operation": "additional_outcomes",
      "signature": "(observed_outcomes: 'float', counterfactual_outcomes: 'float', displacement_fraction: 'float', persistence_fraction: 'float') -> 'dict'",
      "argument_units": {
        "observed_outcomes": "$outcome",
        "counterfactual_outcomes": "$outcome",
        "displacement_fraction": "decimal",
        "persistence_fraction": "decimal"
      },
      "output_unit": "additional_outcomes_scenario",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "cost_per_additional_outcome",
      "signature": "(total_cost: 'float', additional_outcomes: 'float') -> 'float'",
      "argument_units": {
        "total_cost": "$money",
        "additional_outcomes": "$outcome"
      },
      "output_unit": "money_per_outcome",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "dscr",
      "signature": "(cash_available: 'float', debt_service: 'float') -> 'float'",
      "argument_units": {
        "cash_available": "$money",
        "debt_service": "$money"
      },
      "output_unit": "multiple",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "grant_equivalent",
      "signature": "(disbursement: 'float', annual_repayments: 'list[float]', market_discount_rate: 'float') -> 'dict'",
      "argument_units": {
        "disbursement": "$money",
        "annual_repayments": "$money",
        "market_discount_rate": "decimal"
      },
      "output_unit": "grant_equivalent_scenario",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "holding_period_return",
      "signature": "(initial_dirty_price: 'float', exit_dirty_price: 'float', cash_income: 'float', funding_cost: 'float', transaction_cost: 'float') -> 'float'",
      "argument_units": {
        "initial_dirty_price": "$money",
        "exit_dirty_price": "$money",
        "cash_income": "$money",
        "funding_cost": "$money",
        "transaction_cost": "$money"
      },
      "output_unit": "decimal_return",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "loss_waterfall",
      "signature": "(total_loss: 'float', junior_capital: 'float', mezzanine_capital: 'float', senior_capital: 'float') -> 'dict'",
      "argument_units": {
        "total_loss": "$money",
        "junior_capital": "$money",
        "mezzanine_capital": "$money",
        "senior_capital": "$money"
      },
      "output_unit": "loss_allocation",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "mobilisation_ratio",
      "signature": "(incremental_commercial_finance: 'float', development_finance: 'float') -> 'dict'",
      "argument_units": {
        "incremental_commercial_finance": "$money",
        "development_finance": "$money"
      },
      "output_unit": "mobilisation_ratio",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "npv",
      "signature": "(cashflows: 'list[float]', annual_discount: 'float') -> 'float'",
      "argument_units": {
        "cashflows": "$money",
        "annual_discount": "decimal"
      },
      "output_unit": "$money",
      "description": "Periodic NPV; cashflows[0] is at time zero, then annual periods."
    },
    {
      "operation": "scale",
      "signature": "(value: 'float', factor: 'float') -> 'float'",
      "argument_units": {
        "value": "$input_unit",
        "factor": "conversion_factor"
      },
      "output_unit": "$output_unit",
      "description": "Explicit arithmetic conversion; external unit semantics need human review."
    }
  ]
}
